class Solution {
public:
    int longestSubsequence(vector<int>& nums) {
        int totalXor = 0;
        bool hasNonZero = false;

        for (int x : nums) {
            totalXor ^= x;
            if (x > 0) {
                hasNonZero = true;
            }
        }

        // Case 1: Entire array has a non-zero XOR sum
        if (totalXor != 0) {
            return nums.size();
        }

        // Case 2: Array XOR sum is 0, but has at least one non-zero element
        if (hasNonZero) {
            return nums.size() - 1;
        }

        // Case 3: All elements are 0
        return 0;
    }
};