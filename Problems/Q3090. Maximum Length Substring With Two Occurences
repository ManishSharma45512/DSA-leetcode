class Solution {
public:
    int maximumLengthSubstring(string s) {
        vector<int> freq(26, 0); // Frequency array for lowercase English letters
        int left = 0;
        int maxLen = 0;

        for (int right = 0; right < s.length(); right++) {
            freq[s[right] - 'a']++;

            // If any character occurs more than 2 times, shrink the window from left
            while (freq[s[right] - 'a'] > 2) {
                freq[s[left] - 'a']--;
                left++;
            }

            // Update maximum valid substring length
            maxLen = max(maxLen, right - left + 1);
        }

        return maxLen;
    }
};